        Existem tarefas importantes que precisam de atenção.
      </span>

    </ng-container>
  </div>
</div> -->

<!-- LEGENDA DOS ESTADOS -->
<div class="legenda-estados">

  <div class="legenda-titulo">
    Estado da casa
  </div>

  <div class="legenda-item estado-em-dia">
    <span class="legenda-indicador"></span>
    <div>
      <strong>🟢 Em dia</strong>
      <span>Não existem tarefas pendentes ou atrasadas.</span>
    </div>
  </div>

  <div class="legenda-item estado-atencao">
    <span class="legenda-indicador"></span>
    <div>
      <strong>🟡 Atenção</strong>
      <span>Existem algumas tarefas por fazer ou atrasadas.</span>
    </div>
  </div>

  <div class="legenda-item estado-acumulado">
    <span class="legenda-indicador"></span>
    <div>
      <strong>🟠 Acumulado</strong>
      <span>Existem várias tarefas pendentes ou atrasadas.</span>
    </div>
  </div>

  <div class="legenda-item estado-intervencao">
    <span class="legenda-indicador"></span>
    <div>
      <strong>🔴 Intervenção</strong>
      <span>Existem tarefas essenciais que precisam de atenção.</span>
    </div>
  </div>

</div>


        <!-- =================================================
             LISTA DO HISTÓRICO
             ================================================= -->

        <ion-list
          *ngIf="tarefasHistorico.length > 0">


          <ion-item
            *ngFor="let item of tarefasHistorico"
            class="historico-tarefa"
            [class]="obterClasseEstado(item.estado)">


            <ion-label>

              <h2>

                🧹 {{ item.tarefa.nome }}

              </h2>


              <p>

                📍
                {{ obterNomeDivisao(item.divisaoId) }}

              </p>


              <p>

                Última vez:
                <strong>
                  {{ obterTextoUltimaVez(item.diasDesdeUltima) }}
                </strong>

              </p>


              <p>

                Habitualmente:
                <strong>
                  {{ obterTextoHabitual(item.intervaloDias) }}
                </strong>

              </p>


              <p
                class="historico-estado-texto">

                <strong>

                  {{ obterTextoEstado(item.estado) }}

                </strong>

                ·

                {{ obterTextoAtraso(item.diasAtraso) }}

              </p>


              <p class="historico-data">

                Realizada em
                {{ formatarData(item.ultimaData) }}

              </p>

            </ion-label>


            <div
              slot="end"
              class="historico-prioridade">

              P{{ item.tarefa.prioridade }}

            </div>


          </ion-item>

        </ion-list>



        <!-- =================================================
             SEM HISTÓRICO
             ================================================= -->

        <div
          *ngIf="tarefasHistorico.length === 0"
          class="historico-vazio">

          <div class="historico-vazio-icon">

            🧹

          </div>


          <h2>

            Ainda não existem limpezas registadas

          </h2>


          <p>

            Quando guardares uma tarefa como realizada,
            ela aparecerá aqui com a sua evolução.

          </p>

        </div>


      </div>

    </ion-accordion>


  </ion-accordion-group>



  <!-- =====================================================
       REPOR DADOS
       ===================================================== -->

  <div class="repor-dados-wrapper">

    <ion-button
      expand="block"
      fill="outline"
      color="warning"
      (click)="reporDadosOriginais()">

      ♻️ Repor dados originais

    </ion-button>

  </div>


  <br>

  <br>

  <br>

</ion-content>